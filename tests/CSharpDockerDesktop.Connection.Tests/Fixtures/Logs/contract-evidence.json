    "streams": {
      "1": "stdout",
      "2": "stderr",
      "3": "in-band daemon error"
    },
    "contentType": "raw-stream through API 1.41; non-TTY multiplexed-stream from API 1.42; TTY raw-stream",
    "timestamps": "RFC3339NanoFixed timestamp plus space before each daemon log message",
    "since": "Exact seconds.nanoseconds accepted by daemon ParseTimestamps"
