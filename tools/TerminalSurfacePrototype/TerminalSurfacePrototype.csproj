<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-desktop</TargetFramework>
    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <ApplicationTitle>Terminal surface research</ApplicationTitle>
    <ApplicationId>org.csharpdockerdesktop.terminalresearch</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <UnoFeatures>SkiaRenderer;WebView</UnoFeatures>
    <UseMonoRuntime>false</UseMonoRuntime>
    <!-- Keep Uno's development server/hot-reload runtime out of this sensitive surface experiment. -->
    <Optimize>true</Optimize>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/CSharpDockerDesktop.Application/CSharpDockerDesktop.Application.csproj" />
    <EmbeddedResource Include="Web/*" />
    <Content Include="ThirdParty/*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
