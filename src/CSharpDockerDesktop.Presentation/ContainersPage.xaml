<Page x:Class="CSharpDockerDesktop.Presentation.ContainersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:CSharpDockerDesktop.Presentation">
  <Page.Resources><SolidColorBrush x:Key="StatsChartBrush" Color="#0086C9" /></Page.Resources>
  <Grid Padding="24" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Containers" Style="{ThemeResource TitleTextBlockStyle}" AutomationProperties.AutomationId="ResourcePageTitle" />
    <StackPanel Grid.Row="1" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="StartButton" Content="Start" Click="OnStart" AutomationProperties.Name="Start selected container" />
        <Button x:Name="StopButton" Content="Stop" Click="OnStop" AutomationProperties.Name="Stop selected container" />
        <Button x:Name="RestartButton" Content="Restart" Click="OnRestart" AutomationProperties.Name="Restart selected container" />
        <Button x:Name="DeleteButton" Content="Delete…" Click="OnDelete" AutomationProperties.Name="Confirm ordinary deletion of selected container, preserve volumes" />
        <Button x:Name="ForceDeleteButton" Content="Dangerous Force Delete…" Click="OnForceDelete" AutomationProperties.Name="Confirm dangerous force deletion of selected container, preserve volumes" />
      </StackPanel>
      <TextBlock x:Name="ActionStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <StackPanel Grid.Row="5" Spacing="4">
      <ScrollViewer MaxHeight="150" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="OperationStatus" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Retained container operation status" AutomationProperties.LiveSetting="Polite" />
      </ScrollViewer>
      <TextBlock x:Name="AdmissionStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
      <Button x:Name="OperationDetailsButton" Content="Show original daemon content (may be sensitive)" Click="OnOperationDetails" />
      <ScrollViewer x:Name="OperationDetailsPanel" MaxHeight="120" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
        <TextBlock x:Name="OperationDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
      </ScrollViewer>
    </StackPanel>
    <Grid Grid.Row="2" ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" PlaceholderText="Search name, ID, image or status" TextChanged="OnSearch"
               AutomationProperties.Name="Search loaded containers" AutomationProperties.AutomationId="ContainerSearch" />
      <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh containers" Click="OnRefresh" />
      <Button x:Name="OpenButton" Grid.Column="2" Content="Open Overview" Click="OnOpen" />
      <Button x:Name="CopyButton" Grid.Column="3" Content="Copy full ID" Click="OnCopy" />
    </Grid>
    <TextBlock x:Name="ListStatus" Grid.Row="3" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="ContainerListStatus" />
    <!-- The bounded ListView owns its scrolling; ItemsStackPanel recycles rows. Never wrap it in a ScrollViewer. -->
    <ListView x:Name="ContainerList" Grid.Row="4" SelectionMode="Single" SelectionChanged="OnSelectionChanged"
              IsItemClickEnabled="False" DoubleTapped="OnListDoubleTapped"
              AutomationProperties.Name="Containers" AutomationProperties.AutomationId="ContainerList"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
      <ListView.ItemTemplate>
        <DataTemplate x:DataType="local:ContainerRow">
          <Grid Padding="8" RowSpacing="4" AutomationProperties.Name="{x:Bind AccessibleSummary}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="1" Text="{x:Bind Image}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"><TextBlock Text="State:" /><TextBlock Text="{x:Bind State}" /><TextBlock Text="{x:Bind Status}" TextTrimming="CharacterEllipsis" /></StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="ID:" /><TextBlock Text="{x:Bind ShortId}" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"><TextBlock Text="Health:" /><TextBlock Text="{x:Bind Health}" TextTrimming="CharacterEllipsis" /></StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8"><TextBlock Text="Created:" /><TextBlock Text="{x:Bind Created}" /></StackPanel>
            <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8"><TextBlock Text="Ports:" /><TextBlock Text="{x:Bind Ports}" TextTrimming="CharacterEllipsis" /></StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" />
        </Style>
      </ListView.ItemContainerStyle>
    </ListView>
    <TextBlock Grid.Row="6" Text="Lifecycle actions use current Engine observations. Logs supports recent output, live follow and retained search. Stats shows active selected-container resource activity. Terminal is pending."
               TextWrapping="Wrap" Style="{ThemeResource CaptionTextBlockStyle}" />
    <Border x:Name="DetailPanel" Grid.Row="2" Grid.RowSpan="3" Visibility="Collapsed" Padding="16"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" BorderThickness="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <Grid RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="12">
          <Button x:Name="CloseDetailButton" Content="Back to containers" Click="OnCloseDetail" />
          <Button x:Name="OverviewTab" Content="Overview" Click="OnOverviewTab" />
          <Button x:Name="InspectTab" Content="Inspect" Click="OnInspectTab" AutomationProperties.Name="Show raw JSON Inspect" />
          <Button x:Name="StatsTab" Content="Stats" Click="OnStatsTab" AutomationProperties.Name="Open container Stats" />
          <Button x:Name="LogsTab" Content="Logs" Click="OnLogsTab" AutomationProperties.Name="Open container Logs" />
          <Button x:Name="RefreshDetailButton" Content="Refresh details" Click="OnRefreshDetail" />
          <Button Content="Copy full ID" Click="OnCopy" />
        </StackPanel>
        <TextBlock x:Name="DetailStatus" Grid.Row="1" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <ScrollViewer x:Name="OverviewPanel" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
          <TextBlock x:Name="OverviewText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Container Overview" />
        </ScrollViewer>
        <ScrollViewer x:Name="StatsPanel" Grid.Row="2" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StatsReopen" Content="Reopen Stats" Click="OnStatsReopen" /><Button x:Name="StatsDaemonButton" Content="Show original daemon content (may be sensitive)" Click="OnStatsDaemon" Visibility="Collapsed" /></StackPanel>
            <TextBlock x:Name="StatsStatus" TextWrapping="Wrap" AutomationProperties.Name="Stats session state" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="StatsValues" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.Name="Current Stats values and provenance" />
            <TextBlock x:Name="StatsRetention" TextWrapping="Wrap" />
            <TextBlock x:Name="StatsDaemonText" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            <TextBlock Text="History charts · gaps break lines. Each metric has its own labelled scale; Block I/O is activity, not disk space. Times are UTC." TextWrapping="Wrap" />
            <StackPanel x:Name="StatsCharts" Spacing="10" AutomationProperties.Name="Bounded Stats history charts" />
          </StackPanel>
        </ScrollViewer>
        <Grid x:Name="LogsPanel" Grid.Row="2" RowSpacing="6" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBox x:Name="LogsSearch" PlaceholderText="Plain-text search across retained Logs" TextChanged="OnLogsSearch" AutomationProperties.Name="Search retained Logs" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <ComboBox x:Name="LogsFilter" SelectedIndex="0" SelectionChanged="OnLogsFilter" AutomationProperties.Name="Log stream filter"><ComboBoxItem Content="All streams" /><ComboBoxItem Content="stdout" /><ComboBoxItem Content="stderr" /></ComboBox>
            <CheckBox x:Name="LogsAutoscroll" Content="Autoscroll" IsChecked="True" Checked="OnLogsAutoscroll" Unchecked="OnLogsAutoscroll" />
            <CheckBox x:Name="LogsFollow" Content="Live follow on next open" IsChecked="True" />
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="Reopen Logs" Click="OnLogsReopen" /><Button Content="Clear local view" Click="OnLogsClear" /><Button Content="Older matches" Click="OnLogsOlder" /><Button Content="Newer matches" Click="OnLogsNewer" /></StackPanel>
          <StackPanel Grid.Row="3" Spacing="2"><TextBlock x:Name="LogsStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="LogsRetention" TextWrapping="Wrap" /><TextBlock x:Name="LogsSearchStatus" TextWrapping="Wrap" /></StackPanel>
          <StackPanel Grid.Row="4" Spacing="4"><Button x:Name="LogsDaemonButton" Content="Show original daemon content (may be sensitive)" Click="OnLogsDaemon" Visibility="Collapsed" /><ScrollViewer x:Name="LogsDaemonPanel" MaxHeight="80" Visibility="Collapsed"><TextBlock x:Name="LogsDaemonText" TextWrapping="Wrap" IsTextSelectionEnabled="True" /></ScrollViewer></StackPanel>
          <!-- The finite viewport owns scrolling. Only a bounded page of original log strings is retained. -->
          <ListView x:Name="LogsList" Grid.Row="5" SelectionMode="Single" AutomationProperties.Name="Container log rows" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemTemplate><DataTemplate x:DataType="local:ContainerLogRow"><StackPanel Spacing="2"><TextBlock Text="{x:Bind Metadata}" /><TextBlock Text="{x:Bind Text}" FontFamily="Consolas" IsTextSelectionEnabled="True" /></StackPanel></DataTemplate></ListView.ItemTemplate>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListView.ItemContainerStyle>
          </ListView>
        </Grid>
        <Grid x:Name="InspectPanel" Grid.Row="2" RowSpacing="8" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <TextBox x:Name="InspectSearch" PlaceholderText="Search all JSON names and values" TextChanged="OnInspectSearch" AutomationProperties.Name="Search Inspect including collapsed content" />
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="ExpandNodeButton" Content="Expand selected" Click="OnExpandNode" />
            <Button x:Name="CollapseNodeButton" Content="Collapse selected" Click="OnCollapseNode" />
            <Button x:Name="CopyPathButton" Content="Copy selected path" Click="OnCopyPath" />
            <Button x:Name="CopyValueButton" Content="Copy selected JSON value" Click="OnCopyValue" />
          </StackPanel>
          <StackPanel Grid.Row="2" Spacing="4">
            <TextBlock Text='Path: $ is root; ["name",0] is an object property with zero-based duplicate occurrence; [0] is an array index. Names use JSON escaping. Copy value preserves exact JSON, including sensitive fields.' TextWrapping="Wrap" />
            <TextBlock x:Name="InspectStatus" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
          <!-- Finite viewport with recycling, never recursive visual children or an outer ScrollViewer. -->
          <ListView x:Name="InspectList" Grid.Row="3" SelectionMode="Single" SelectionChanged="OnInspectSelection" AutomationProperties.Name="Inspect JSON nodes" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate></ListView.ItemsPanel>
            <ListView.ItemTemplate><DataTemplate x:DataType="local:JsonInspectRow"><TextBlock Text="{x:Bind Text}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" AutomationProperties.Name="{x:Bind AccessibleSummary}" /></DataTemplate></ListView.ItemTemplate>
            <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleSummary}" /></Style></ListView.ItemContainerStyle>
          </ListView>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Page>
