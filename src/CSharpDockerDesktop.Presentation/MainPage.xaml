<Page x:Class="CSharpDockerDesktop.Presentation.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Padding="24,16" BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
      <StackPanel Spacing="8">
        <Grid ColumnSpacing="24">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="CSharpDockerDesktop" Style="{ThemeResource TitleTextBlockStyle}"
                     TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Retry connection" Click="OnRetry"
                  AutomationProperties.AutomationId="RetryConnection"
                  AutomationProperties.Name="Retry Docker Engine connection" />
        </Grid>
        <StackPanel Spacing="8">
          <ComboBox x:Name="RuntimeChoices" Header="Installed Docker runtime" DisplayMemberPath="Name"
                    SelectionChanged="OnRuntimeSelectionChanged" HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Installed Docker runtime to start" />
          <TextBlock x:Name="RuntimeDestination" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button x:Name="StartRuntime" Content="Start Docker runtime" Click="OnStartRuntime"
                    AutomationProperties.Name="Start selected installed Docker runtime" />
            <Button x:Name="CancelRuntime" Content="Cancel startup" Click="OnCancelRuntime"
                    AutomationProperties.Name="Cancel waiting for runtime startup" />
          </StackPanel>
          <TextBlock x:Name="RuntimeStatus" TextWrapping="Wrap" />
        </StackPanel>
        <Expander x:Name="EndpointEditor" Header="Select Engine endpoint" HorizontalAlignment="Stretch"
                  AutomationProperties.Name="Select Docker Engine endpoint">
          <StackPanel Spacing="8">
            <TextBox x:Name="EndpointDraft" Header="Endpoint address (draft)" MaxLength="2048"
                     PlaceholderText="npipe://./pipe/docker_engine or unix:///absolute/path/docker.sock" TextChanged="OnEndpointDraftChanged"
                     AutomationProperties.AutomationId="EndpointDraft"
                     AutomationProperties.Name="Docker Engine endpoint address draft" />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Name="ApplyEndpoint" Content="Apply / Connect" Click="OnApplyEndpoint"
                      AutomationProperties.AutomationId="ApplyEndpoint"
                      AutomationProperties.Name="Apply endpoint and connect" />
              <Button x:Name="UseDefaultEndpoint" Content="Use default local endpoint" Click="OnUseDefaultEndpoint"
                      AutomationProperties.AutomationId="UseDefaultEndpoint"
                      AutomationProperties.Name="Select default local endpoint and connect" />
            </StackPanel>
            <TextBlock x:Name="EndpointDraftStatus" TextWrapping="Wrap" />
            <TextBlock Text="Selection is kept only for this app session. Windows uses local named pipes; macOS uses local Unix sockets."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
        <TextBlock x:Name="SelectedEndpoint" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                   AutomationProperties.AutomationId="SelectedEndpoint" />
        <TextBlock x:Name="EngineStatus" AutomationProperties.AutomationId="EngineStatus"
                   FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ConnectionDiagnostic" TextWrapping="Wrap" />
        <Expander Header="Connection details" HorizontalAlignment="Stretch">
          <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8">
              <TextBlock x:Name="ConnectionDetails" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
              <Button x:Name="ShowDaemonMessage" Content="Show daemon message" Click="OnShowDaemonMessage"
                      Visibility="Collapsed" />
              <TextBlock x:Name="DaemonMessage" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                         Visibility="Collapsed" />
            </StackPanel>
          </ScrollViewer>
        </Expander>
      </StackPanel>
    </Border>
    </ScrollViewer>
    <NavigationView x:Name="ResourceNavigation" Grid.Row="1"
                    PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="220"
                    IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                    AlwaysShowHeader="False" SelectionChanged="OnResourceSelectionChanged"
                    AutomationProperties.Name="Resources">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="ContainersItem" Content="Containers" Tag="Containers"
                            AutomationProperties.AutomationId="ContainersNavigation">
        </NavigationViewItem>
        <NavigationViewItem Content="Images" Tag="Images"
                            AutomationProperties.AutomationId="ImagesNavigation">
        </NavigationViewItem>
        <NavigationViewItem Content="Volumes" Tag="Volumes"
                            AutomationProperties.AutomationId="VolumesNavigation">
        </NavigationViewItem>
        <NavigationViewItem Content="Networks" Tag="Networks"
                            AutomationProperties.AutomationId="NetworksNavigation">
        </NavigationViewItem>
      </NavigationView.MenuItems>
      <Frame x:Name="ResourceFrame" IsNavigationStackEnabled="False" />
    </NavigationView>
  </Grid>
</Page>
